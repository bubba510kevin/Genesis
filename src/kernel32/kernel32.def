; Export list for kernel32.dll.
;
; A .def rather than __declspec(dllexport), for the same reason ntdll has one:
; the export table IS the interface, and adding to it should be a deliberate
; act rather than a side effect of a keyword. x86-64 has no name decoration,
; so these names appear in the export directory exactly as written - which is
; what the kernel's IAT resolution looks up.
;
; Forwarders and ordinal-only exports, both of which pe.c used to refuse.
;
; This comment used to say "no forwarders", because the loader returned 0 for
; any export whose RVA landed inside the export directory. It follows them
; now, so the two entries at the bottom of this file exist to prove it - and
; they are the only reason they exist. A real kernel32 forwards plenty
; (HeapAlloc to ntdll's RtlAllocateHeap is the classic), but the wrappers in
; proc.c are still the honest version of that for this tree: a forwarder here
; would change what those functions DO, and this file's job is the loader
; test, not a redesign of kernel32.
;
; Note what adding K32OrdinalProbe @42 does as a side effect: it moves this
; DLL's ordinal base off 1. That is deliberate and is half the test. An
; ordinal import is resolved as AddressOfFunctions[ordinal - ordinal_base],
; and a loader that skips the subtraction works perfectly on every DLL whose
; base is 1 and silently returns the wrong function here.
LIBRARY kernel32.dll
EXPORTS
; --- errors ---
    GetLastError
    SetLastError
; --- files and handles ---
    GetStdHandle
    CreateFileW
    CreateFileA
    ReadFile
    WriteFile
    CloseHandle
; --- process ---
    ExitProcess
    GetCurrentProcess
    GetCurrentProcessId
    GetCommandLineW
    GetCommandLineA
    GetEnvironmentStringsW
    FreeEnvironmentStringsW
    GetCurrentDirectoryW
    GetModuleHandleW
; --- threads and waiting ---
    CreateThread
    ExitThread
    GetCurrentThread
    GetCurrentThreadId
    GetThreadId
    GetExitCodeThread
    WaitForSingleObject
    CreateMutexW
    CreateMutexA
    ReleaseMutex
; --- processors, affinity, priorities, time (sysinfo.c) ---
    GetSystemInfo
    GetNativeSystemInfo
    GetActiveProcessorCount
    GetMaximumProcessorCount
    GetActiveProcessorGroupCount
    GetMaximumProcessorGroupCount
    GetCurrentProcessorNumber
    GetCurrentProcessorNumberEx
    GetLogicalProcessorInformation
    GetLogicalProcessorInformationEx
    GetProcessAffinityMask
    SetProcessAffinityMask
    SetThreadAffinityMask
    SetThreadIdealProcessor
    SetThreadIdealProcessorEx
    GetThreadIdealProcessorEx
    SetThreadGroupAffinity
    GetThreadGroupAffinity
    SetThreadPriority
    GetThreadPriority
    SetPriorityClass
    GetPriorityClass
    GetProcessTimes
    GetThreadTimes
    SwitchToThread
    Sleep
    SleepEx
    QueryPerformanceCounter
    QueryPerformanceFrequency
    GetTickCount
    GetTickCount64
    GetSystemTimeAsFileTime
    GetSystemTimePreciseAsFileTime
; --- synchronisation: wrappers where the Win32 signature differs ... ---
    InitializeCriticalSectionAndSpinCount
    InitializeCriticalSectionEx
    TryEnterCriticalSection
    SleepConditionVariableCS
    SleepConditionVariableSRW
; ... and FORWARDERS where it does not: these are ntdll's Rtl* under
; kernel32's name, exactly as on Windows. The loader follows each string.
    InitializeCriticalSection = ntdll.RtlInitializeCriticalSection
    EnterCriticalSection = ntdll.RtlEnterCriticalSection
    LeaveCriticalSection = ntdll.RtlLeaveCriticalSection
    DeleteCriticalSection = ntdll.RtlDeleteCriticalSection
    SetCriticalSectionSpinCount = ntdll.RtlSetCriticalSectionSpinCount
    InitializeSRWLock = ntdll.RtlInitializeSRWLock
    AcquireSRWLockExclusive = ntdll.RtlAcquireSRWLockExclusive
    AcquireSRWLockShared = ntdll.RtlAcquireSRWLockShared
    ReleaseSRWLockExclusive = ntdll.RtlReleaseSRWLockExclusive
    ReleaseSRWLockShared = ntdll.RtlReleaseSRWLockShared
    TryAcquireSRWLockExclusive = ntdll.RtlTryAcquireSRWLockExclusive
    TryAcquireSRWLockShared = ntdll.RtlTryAcquireSRWLockShared
    InitializeConditionVariable = ntdll.RtlInitializeConditionVariable
    WakeConditionVariable = ntdll.RtlWakeConditionVariable
    WakeAllConditionVariable = ntdll.RtlWakeAllConditionVariable
    InitializeSListHead = ntdll.RtlInitializeSListHead
    InterlockedPushEntrySList = ntdll.RtlInterlockedPushEntrySList
    InterlockedPopEntrySList = ntdll.RtlInterlockedPopEntrySList
    InterlockedFlushSList = ntdll.RtlInterlockedFlushSList
    QueryDepthSList = ntdll.RtlQueryDepthSList
    WaitOnAddress
    WakeByAddressSingle = ntdll.RtlWakeAddressSingle
    WakeByAddressAll = ntdll.RtlWakeAddressAll
; --- thread-local storage (tls.c) ---
    TlsAlloc
    TlsFree
    TlsGetValue
    TlsSetValue
    FlsAlloc
    FlsFree
    FlsGetValue
    FlsSetValue
; --- memory ---
    GetProcessHeap
    HeapAlloc
    HeapFree
    VirtualAlloc
    VirtualFree
; --- loader test entries (see the note above) ---
; Ordinal-only: no name-table entry, reachable only as kernel32.dll#42.
    K32OrdinalProbe @42 NONAME
; A real forwarder: the export directory holds the string "ntdll.NtCurrentTeb"
; where a function RVA would be, and the loader has to follow it into a DLL
; this one already depends on.
    K32CurrentTeb = ntdll.NtCurrentTeb
