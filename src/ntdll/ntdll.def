; Export list for ntdll.dll.
;
; A .def rather than __declspec(dllexport) on each function, because the
; export table IS the interface: one file to read to know what the DLL
; promises, and adding an export becomes a deliberate act rather than a side
; effect of a keyword someone typed. x86-64 has no name decoration, so what
; is written here is exactly what appears in the export directory - which is
; what item 7's IAT resolution will look names up in.
LIBRARY ntdll.dll
EXPORTS
; --- the native system-call interface ---
    NtDisplayString
    NtTerminateProcess
    NtOpenFile
    NtClose
    NtReadFile
    NtWriteFile
    NtAllocateVirtualMemory
; --- the dispatcher objects ---
    NtCreateEvent
    NtOpenEvent
    NtSetEvent
    NtResetEvent
    NtWaitForSingleObject
    NtWaitForMultipleObjects
    NtCreateSemaphore
    NtReleaseSemaphore
    NtCreateMutant
    NtReleaseMutant
; --- threads ---
    NtCreateThreadEx
    NtTerminateThread
    NtQueryInformationThread
    NtSuspendThread
    NtResumeThread
; --- the machine, processes and scheduling ---
    NtQuerySystemInformation
    NtQuerySystemInformationEx
    NtQueryInformationProcess
    NtSetInformationProcess
    NtSetInformationThread
    NtYieldExecution
    NtDelayExecution
    NtGetCurrentProcessorNumber
    NtGetCurrentProcessorNumberEx
    NtQueryPerformanceCounter
    NtQuerySystemTime
    NtWaitForAlertByThreadId
    NtAlertThreadByThreadId
    RtlWaitOnAddress
    RtlWakeAddressSingle
    RtlWakeAddressAll
; --- synchronisation ---
    RtlInitializeCriticalSection
    RtlInitializeCriticalSectionAndSpinCount
    RtlInitializeCriticalSectionEx
    RtlEnterCriticalSection
    RtlTryEnterCriticalSection
    RtlLeaveCriticalSection
    RtlDeleteCriticalSection
    RtlSetCriticalSectionSpinCount
    RtlIsCriticalSectionLockedByThread
    RtlInitializeSRWLock
    RtlAcquireSRWLockExclusive
    RtlAcquireSRWLockShared
    RtlReleaseSRWLockExclusive
    RtlReleaseSRWLockShared
    RtlTryAcquireSRWLockExclusive
    RtlTryAcquireSRWLockShared
    RtlInitializeConditionVariable
    RtlWakeConditionVariable
    RtlWakeAllConditionVariable
    RtlSleepConditionVariableCS
    RtlSleepConditionVariableSRW
    RtlInitializeSListHead
    RtlInterlockedPushEntrySList
    RtlInterlockedPopEntrySList
    RtlInterlockedFlushSList
    RtlFirstEntrySList
    RtlQueryDepthSList
; --- thread-local storage ---
    RtlFlsAlloc
    RtlFlsFree
    RtlFlsGetValue
    RtlFlsSetValue
    LdrShutdownProcess
; --- processors and time ---
    RtlGetCurrentProcessorNumber
    RtlGetCurrentProcessorNumberEx
    RtlQueryPerformanceCounter
    RtlQueryPerformanceFrequency
; --- the runtime library ---
    NtCurrentTeb
    RtlInitUnicodeString
    RtlDosPathNameToNtPathName_U
    RtlAllocateHeap
    RtlFreeHeap
    LdrInitializeThunk
    RtlUserThreadStart
    RtlExitUserThread
